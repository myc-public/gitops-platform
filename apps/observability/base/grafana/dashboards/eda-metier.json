    {
      "type": "stat",
      "id": 11,
      "title": "Donateurs créés",
      "description": "Depuis le dernier démarrage de l'API (compteur Prometheus : l'index des donateurs reste hors de portée de Grafana)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(domain_events_total{event_type=\"DonorCreated\"}) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
