        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kafka_consumer_consumer_fetch_manager_metrics_records_lag{topic=~\".*\\\\.events\"}) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
