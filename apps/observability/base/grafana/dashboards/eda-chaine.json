    {
      "type": "timeseries",
      "id": 8,
      "title": "Latence de bout en bout",
      "description": "De occurredAt à indexedAt",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch-eda"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch-eda"
          },
          "query": "_exists_:latencyMs",
          "timeField": "occurredAt",
          "metrics": [
            {
              "id": "1",
              "type": "percentiles",
              "field": "latencyMs",
              "settings": {
                "percents": [
                  "50",
                  "95",
                  "99"
                ]
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "occurredAt",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
