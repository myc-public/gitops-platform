{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "index.default_pipeline": "donations"
  },
  "aliases": {
    "donation.events": { "is_write_index": true },
    "donations": {}
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "eventId": { "type": "keyword" },
      "eventType": { "type": "keyword" },
      "eventVersion": { "type": "keyword" },
      "occurredAt": { "type": "date" },
      "aggregateType": { "type": "keyword" },
      "aggregateId": { "type": "keyword" },
      "producer": { "type": "keyword" },
      "traceId": { "type": "keyword" },
      "indexedAt": { "type": "date" },
      "payload": {
        "dynamic": "strict",
        "properties": {
          "category": { "type": "keyword" },
          "type": { "type": "boolean" },
          "amount": { "type": "scaled_float", "scaling_factor": 100 },
          "timestamp": { "type": "date" },
          "donorID": { "type": "keyword" },
          "country": { "type": "keyword" }
        }
      }
    }
  }
}
