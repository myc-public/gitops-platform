{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "donation-api-mysql",
  "database.port": "3306",
  "database.user": "debezium",
  "database.password": "${file:/etc/kafka-connect/secrets/connect.properties:db.password}",
  "database.server.id": "184054",
  "topic.prefix": "donation",
  "database.include.list": "donation_api",
  "table.include.list": "donation_api.outbox_event",
  "include.schema.changes": "false",
  "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
  "schema.history.internal.kafka.topic": "schema.donation",
  "snapshot.mode": "no_data",
  "snapshot.locking.mode": "none",
  "skipped.operations": "u,d",
  "value.converter": "org.apache.kafka.connect.storage.StringConverter",
  "transforms": "outbox,lowerDonation,lowerDonor,dropHeaders",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id": "event_id",
  "transforms.outbox.table.field.event.key": "aggregate_id",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.route.by.field": "aggregate_type",
  "transforms.outbox.route.topic.replacement": "${routedByValue}.events",
  "transforms.outbox.table.fields.additional.placement": "event_type:header:eventType,event_version:header:eventVersion,traceparent:header:traceparent",
  "transforms.lowerDonation.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.lowerDonation.regex": "Donation\\.events",
  "transforms.lowerDonation.replacement": "donation.events",
  "transforms.lowerDonor.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.lowerDonor.regex": "Donor\\.events",
  "transforms.lowerDonor.replacement": "donor.events",
  "transforms.dropHeaders.type": "org.apache.kafka.connect.transforms.DropHeaders",
  "transforms.dropHeaders.headers": "id,__debezium.context.connectorLogicalName,__debezium.context.taskId,__debezium.context.connectorName,__debezium.context.runId"
}
