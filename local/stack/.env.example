# Mode pile (K5) : copier en local/stack/.env (ignore par Git) et remplacer chaque valeur.
# Generer une valeur (PowerShell) : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Donnees propres a la pile (volumes donation-pile_*) : ces valeurs peuvent differer de celles du mode dev.

# URL publique (APISIX externe) = iss des tokens ; doit correspondre a PILE_HTTPS_PORT
PUBLIC_URL=https://localhost:8443
PILE_HTTPS_PORT=8443
# HSTS : 0 en local (sinon le navigateur force https sur tous les ports de localhost)
HSTS_MAX_AGE=0

# Keycloak (memes variables que local/keycloak/.env)
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
DONATION_WEB_CLIENT_SECRET=
DONATION_BACKOFFICE_CLIENT_SECRET=
DONATION_SERVICE_CLIENT_SECRET=
DONATION_TESTS_CLIENT_SECRET=
# 14 caracteres minimum (politique du realm myc-internal)
TEST_USERS_PASSWORD=

# API et MySQL (memes variables que inner-donation-api/local/.env)
DB_NAME=donation_api
DB_USER=
DB_PASSWORD=
MANAGEMENT_ADMIN_USER=
MANAGEMENT_ADMIN_PWD=
MANAGEMENT_VIEWER_USER=
MANAGEMENT_VIEWER_PWD=
