# Copier en local/keycloak/.env (ignore par Git) et remplacer chaque valeur.
# Generer une valeur (PowerShell) : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Ne pas modifier ce fichier .env apres le premier demarrage sans remise a zero (down -v) : le compte admin
# n'est cree qu'au premier demarrage.
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=changeme
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme
DONATION_WEB_CLIENT_SECRET=changeme
DONATION_BACKOFFICE_CLIENT_SECRET=changeme
DONATION_SERVICE_CLIENT_SECRET=changeme
DONATION_TESTS_CLIENT_SECRET=changeme
# 14 caracteres minimum (politique du realm myc-internal)
TEST_USERS_PASSWORD=changeme
# Optionnel : federation Google / Facebook (myc-customers), desactivee par defaut
# GOOGLE_IDP_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_IDP_ENABLED=true
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
